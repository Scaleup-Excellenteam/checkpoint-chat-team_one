{
  "compilerOptions": {
    /* Base Options */
    "target": "ES2022", // Compile to a modern version of JavaScript
    "esModuleInterop": true, // For better compatibility between module systems
    "forceConsistentCasingInFileNames": true,
    "strict": true, // Enable all strict type-checking options
    "skipLibCheck": true, // Skip type checking of declaration files

    /* Module Options */
    "module": "NodeNext", // Use the modern Node.js module system
    "moduleResolution": "NodeNext" // How to resolve module imports
  }
}
